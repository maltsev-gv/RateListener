<Window x:Class="RateListener.RateHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        Title="Rate history" Height="450" Width="720"
        WindowStartupLocation="CenterOwner">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="5">
            <TextBlock Text="{Binding Direction, StringFormat=Pair: {0}}" FontWeight="Bold" />
            <TextBlock Text="Range:" Margin="15,5,5,5" />
            <ComboBox x:Name="RangeComboBox" Width="90"
                      SelectionChanged="RangeComboBox_OnSelectionChanged" />
            <CheckBox x:Name="InversedCheckBox" Content="Inversed" Margin="15,5,5,5"
                      Checked="InversedCheckBox_OnChanged" Unchecked="InversedCheckBox_OnChanged"
                      ToolTip="Inverse rate (To => From) of the same pair at the same moment" />
        </StackPanel>
        <Grid>
            <lvc:CartesianChart x:Name="Chart" Margin="0,0,0,5"
                                MouseMove="Chart_OnMouseMove" MouseLeave="Chart_OnMouseLeave" />
            <Popup x:Name="PointPopup" Placement="RelativePoint" AllowsTransparency="True"
                   IsHitTestVisible="False">
                <Border Background="#FAFFFFFF" BorderBrush="Gray" BorderThickness="1"
                        CornerRadius="3" Padding="6,4">
                    <TextBlock x:Name="PointPopupText" FontSize="11" />
                </Border>
            </Popup>
        </Grid>
    </DockPanel>
</Window>
